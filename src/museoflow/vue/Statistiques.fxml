<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1244.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="museoflow.controleur.ControleurStatistiques">
   <children>
      <ImageView fitHeight="700.0" fitWidth="1250.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/Background.png" />
         </image>
      </ImageView>
      <TabPane fx:id="tabPane" layoutY="62.0" prefHeight="579.0" prefWidth="1244.0">
         <tabs>
            <!-- Onglet Visites Programmées -->
            <Tab fx:id="ongletExpositions" closable="false" text="Expositions">
               <content>
                  <AnchorPane>
                     <children>
                        
                        <!-- TableView pour les expositions -->
                        <TableView fx:id="tableExpositions" layoutY="10.0" prefHeight="540.0" prefWidth="1240.0" />
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
            <!-- Onglet Conférenciers -->
            <Tab fx:id="ongletConferenciers" closable="false" text="Conférenciers">
               <content>
                  <AnchorPane>
                     <children>
                        <TableView fx:id="tableConferenciers" layoutY="10.0" prefHeight="540.0" prefWidth="1240.0" />
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
         </tabs>
      </TabPane>
      <ImageView fitHeight="65.0" fitWidth="1244.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/BandeauVide.png" />
         </image>
      </ImageView>
      <StackPane prefHeight="55.0" prefWidth="1242.0">
         <children>
            <ComboBox fx:id="filtreTypeExpo" onAction="#filtrerTypeExpo" prefHeight="25.0" prefWidth="210.0" promptText="Filtrer par type d'exposition" StackPane.alignment="CENTER_LEFT">
               <StackPane.margin>
                  <Insets left="150.0" />
               </StackPane.margin>
            </ComboBox>
            <ComboBox fx:id="filtreConferenciers" onAction="#filtrerTypeConferencier" prefHeight="25.0" prefWidth="210.0" promptText="Filtrer par type de conferencier" StackPane.alignment="CENTER_LEFT">
               <StackPane.margin>
                  <Insets left="150.0" />
               </StackPane.margin></ComboBox>
            <Button id="boutonMenuPrincipal" fx:id="boutonMenuPrincipal" mnemonicParsing="false" onAction="#handlerBoutonMenuPrincipal" prefHeight="54.0" prefWidth="49.0" styleClass="bouton-menu-principal" stylesheets="@css/ConsulterDonnees.css" StackPane.alignment="CENTER_LEFT">
               <StackPane.margin>
                  <Insets />
               </StackPane.margin>
               <tooltip>
                  <Tooltip text="Retourner au menu princpal" />
               </tooltip></Button>
         </children>
      </StackPane>
      
      <Button id="boutonRetour" fx:id="boutonRetour" layoutX="6.0" layoutY="644.0" mnemonicParsing="false" onAction="#handlerBoutonRetour" prefHeight="54.0" prefWidth="58.0" styleClass="button-retour" stylesheets="@css/ConsulterDonnees.css">
         <tooltip>
            <Tooltip text="Retourner au menu précédent" />
         </tooltip></Button>
   </children>
</AnchorPane>
