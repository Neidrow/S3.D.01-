<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="museoflow.controleur.ControleurConsulterExpositions" spacing="10">
    <Button text="Retour" onAction="#handlerRetour"/>
    
    <ListView fx:id="listViewExpositions" onMouseClicked="#handleListViewClick"/>
    
    <TextArea fx:id="textAreaDetails" editable="false" prefHeight="200"/>
</VBox>
